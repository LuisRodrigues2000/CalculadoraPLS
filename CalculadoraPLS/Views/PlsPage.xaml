<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns:models="clr-namespace:CalculadoraPLS.Models"
    x:Class="CalculadoraPLS.Views.PlsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:CalculadoraPLS.ViewModels"
    BackgroundColor="#FFFFFF"
    Shell.NavBarIsVisible="False">

    <ContentPage.BindingContext>
        <vm:PlsViewModel />
    </ContentPage.BindingContext>

    <ContentPage.Resources>

        <!-- Remove borda azul padrão do Entry no Android -->
        <Style TargetType="Entry">
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Focused">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="Transparent" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Disabled" />
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>

    </ContentPage.Resources>

    <Grid>

        <!-- ═══════════════════════════════════════════ -->
        <!--  CONTEÚDO PRINCIPAL (scrollável)            -->
        <!-- ═══════════════════════════════════════════ -->
        <ScrollView x:Name="MainScroll">
            <VerticalStackLayout Padding="24,52,24,48" Spacing="0">

                <!-- ══════════════════════════════════════════ -->
                <!--  CABEÇALHO                                 -->
                <!-- ══════════════════════════════════════════ -->
                <VerticalStackLayout Spacing="0" Margin="0,0,0,44">

                    <!-- Assinatura -->
                    <Label
                        Text="Desenvolvido por Luis Rodrigues"
                        FontSize="11"
                        FontAttributes="Italic"
                        TextColor="#AAAACC"
                        HorizontalOptions="Center"
                        CharacterSpacing="1"
                        Margin="0,0,0,18" />

                    <!-- Logo PLS — preto bold, estilo ZAMP -->
                    <Label
                        Text="PLS"
                        FontSize="72"
                        FontAttributes="Bold"
                        TextColor="#0A0066"
                        HorizontalOptions="Center"
                        CharacterSpacing="5" />

                    <!-- Subtítulo azul elétrico -->
                    <Label
                        Text="CALCULADORA DE PRODUÇÃO"
                        FontSize="11"
                        FontAttributes="Bold"
                        TextColor="#0008FF"
                        HorizontalOptions="Center"
                        CharacterSpacing="5"
                        Margin="0,6,0,0" />

                    <!-- Linha decorativa -->
                    <Grid Margin="0,22,0,0" HeightRequest="2">
                        <BoxView BackgroundColor="#EEEEEE" />
                        <BoxView
                            BackgroundColor="#0008FF"
                            WidthRequest="48"
                            HeightRequest="2"
                            HorizontalOptions="Center" />
                    </Grid>

                </VerticalStackLayout>

                <!-- ══════════════════════════════════════════ -->
                <!--  PAINEL DE VENDAS                          -->
                <!-- ══════════════════════════════════════════ -->
                <VerticalStackLayout Spacing="12" Margin="0,0,0,28">

                    <Label
                        Text="VENDAS"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="#0A0066"
                        CharacterSpacing="5"
                        Margin="2,0,0,4" />


                    <!-- Card: Venda Estimada -->
                    <Border
                        x:Name="CardEstimada"
                        BackgroundColor="#FFFFFF"
                        StrokeShape="RoundRectangle 16"
                        Stroke="#E8E8F0"
                        StrokeThickness="1.5"
                        Padding="20,16">
                        <Border.Shadow>
                            <Shadow Brush="#0008FF" Offset="0,2" Radius="12" Opacity="0.06" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCardEstimadaTapped" />
                        </Border.GestureRecognizers>
                        <Grid RowDefinitions="*,2">
                            <VerticalStackLayout Grid.Row="0" Spacing="6">
                                <Label
                                    Text="VENDA ESTIMADA"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    TextColor="#0A0066"
                                    CharacterSpacing="3" />

                                <Entry
                                    x:Name="EntryEstimada"
                                    Text="{Binding VendaEstimadaFormatada}"
                                    Keyboard="Numeric"
                                    ReturnType="Next"
                                    FontSize="36"
                                    FontAttributes="Bold"
                                    TextColor="#0A0066"
                                    BackgroundColor="Transparent"
                                    PlaceholderColor="#CCCCDD"
                                    Placeholder="R$ 0,00"
                                    Focused="EntryEstimada_Focused"
                                    Unfocused="EntryEstimada_Unfocused"
                                    TextChanged="EntryEstimada_TextChanged"
                                    Completed="EntryEstimada_Completed" />
                            </VerticalStackLayout>
                            <!-- Linha de foco — começa cinza, vira azul -->
                            <BoxView
                                x:Name="FocusLineEstimada"
                                Grid.Row="1"
                                HeightRequest="2"
                                BackgroundColor="#E8E8F0"
                                VerticalOptions="End" />
                        </Grid>
                    </Border>

                    <!-- Card: Venda Real -->
                    <Border
                        x:Name="CardReal"
                        BackgroundColor="#FFFFFF"
                        StrokeShape="RoundRectangle 16"
                        Stroke="#E8E8F0"
                        StrokeThickness="1.5"
                        Padding="20,16">
                        <Border.Shadow>
                            <Shadow Brush="#0008FF" Offset="0,2" Radius="12" Opacity="0.06" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCardRealTapped" />
                        </Border.GestureRecognizers>
                        <Grid RowDefinitions="*,2">
                            <VerticalStackLayout Grid.Row="0" Spacing="6">
                                <Label
                                    Text="VENDA REAL"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    TextColor="#0A0066"
                                    CharacterSpacing="3" />

                                <Entry
                                    x:Name="EntryReal"
                                    Text="{Binding VendaRealFormatada}"
                                    Keyboard="Numeric"
                                    ReturnType="Done"
                                    FontSize="36"
                                    FontAttributes="Bold"
                                    TextColor="#0A0066"
                                    BackgroundColor="Transparent"
                                    PlaceholderColor="#CCCCDD"
                                    Placeholder="R$ 0,00"
                                    Focused="EntryReal_Focused"
                                    Unfocused="EntryReal_Unfocused"
                                    TextChanged="EntryReal_TextChanged"
                                    Completed="EntryReal_Completed" />
                            </VerticalStackLayout>
                            <BoxView
                                x:Name="FocusLineReal"
                                Grid.Row="1"
                                HeightRequest="2"
                                BackgroundColor="#E8E8F0"
                                VerticalOptions="End" />
                        </Grid>
                    </Border>

                </VerticalStackLayout>

                <!-- ══════════════════════════════════════════ -->
                <!--  BOTÃO CALCULAR                            -->
                <!-- ══════════════════════════════════════════ -->
                <Border
                    x:Name="BtnCalcular"
                    BackgroundColor="#0008FF"
                    StrokeShape="RoundRectangle 16"
                    Stroke="Transparent"
                    Margin="0,0,0,40">
                    <Border.Shadow>
                        <Shadow Brush="#0008FF" Offset="0,6" Radius="20" Opacity="0.35" />
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCalcularTapped" />
                    </Border.GestureRecognizers>
                    <Label
                        Text="CALCULAR"
                        FontSize="15"
                        FontAttributes="Bold"
                        TextColor="#FFFFFF"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        CharacterSpacing="5"
                        Padding="0,22" />
                </Border>

                <!-- ══════════════════════════════════════════ -->
                <!--  PAINEL DE RESULTADOS                      -->
                <!-- ══════════════════════════════════════════ -->
                <VerticalStackLayout
                    x:Name="PainelResultados"
                    IsVisible="False"
                    Opacity="0"
                    TranslationY="40"
                    Spacing="14">

                    <BoxView
                        x:Name="ScrollAnchor"
                        HeightRequest="1"
                        BackgroundColor="Transparent" />

                    <!-- Divisor de seção -->
                    <BoxView HeightRequest="1" BackgroundColor="#EEEEEE" Margin="0,0,0,4" />

                    <!-- Card da diferença percentual -->
                    <Border
                        x:Name="CardDiferenca"
                        BackgroundColor="#FFFFFF"
                        StrokeShape="RoundRectangle 16"
                        Stroke="#E8E8F0"
                        StrokeThickness="1.5"
                        Padding="24,22"
                        Margin="0,0,0,4"
                        Opacity="0"
                        TranslationY="30">
                        <Border.Shadow>
                            <Shadow Brush="#0008FF" Offset="0,4" Radius="16" Opacity="0.08" />
                        </Border.Shadow>
                        <Grid ColumnDefinitions="*,Auto">

                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label
                                    Text="DIFERENÇA"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    TextColor="#0A0066"
                                    CharacterSpacing="5" />

                                <Label
                                    x:Name="LblDiferenca"
                                    Text="0,00%"
                                    FontSize="56"
                                    FontAttributes="Bold"
                                    TextColor="{Binding CorDiferenca}"
                                    LineBreakMode="NoWrap" />
                            </VerticalStackLayout>

                            <!-- Pill de tendência -->
                            <Border
                                BackgroundColor="{Binding CorDiferencaFundo}"
                                StrokeShape="RoundRectangle 10"
                                Stroke="Transparent"
                                Padding="14,8"
                                VerticalOptions="Center"
                                Grid.Column="1">
                                <Label
                                    Text="{Binding LabelTendencia}"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    TextColor="{Binding CorDiferenca}" />
                            </Border>

                        </Grid>
                    </Border>

                    <!-- Título da seção de carnes -->
                    <Label
                        Text="RESULTADO POR CARNE"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="#0A0066"
                        CharacterSpacing="5"
                        Margin="2,50,0,-30" />


                    <!-- Cards de carne via BindableLayout -->
                    <VerticalStackLayout
                        x:Name="ListaCarnes"
                        BindableLayout.ItemsSource="{Binding Resultados}"
                        Spacing="12">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:ResultadoCarne">

                                <Border
                                    BackgroundColor="#FFFFFF"
                                    StrokeShape="RoundRectangle 16"
                                    Stroke="#E8E8F0"
                                    StrokeThickness="1.5"
                                    Padding="22,20"
                                    Opacity="0"
                                    TranslationY="30">
                                    <Border.Shadow>
                                        <Shadow Brush="#0008FF" Offset="0,4" Radius="16" Opacity="0.07" />
                                    </Border.Shadow>

                                    <VerticalStackLayout Spacing="16">
                                        <VerticalStackLayout.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnCardCarneTapped" />
                                        </VerticalStackLayout.GestureRecognizers>

                                        <!-- Cabeçalho: Nome + Chevron -->
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label
                                                Text="{Binding Nome}"
                                                FontSize="22"
                                                FontAttributes="Bold"
                                                TextColor="#0A0066"
                                                VerticalOptions="Center"
                                                CharacterSpacing="1"
                                                Grid.Column="0" />
                                            <Label
                                                Text="›"
                                                FontSize="32"
                                                FontAttributes="Bold"
                                                TextColor="#CCCCDD"
                                                VerticalOptions="Center"
                                                Grid.Column="1"
                                                Margin="0,0,2,0" />
                                        </Grid>

                                        <!-- Divisor -->
                                        <BoxView HeightRequest="1" BackgroundColor="#F0F0F8" />

                                        <!-- Recipientes + Restantes -->
                                        <Grid ColumnDefinitions="*,1,*">

                                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                                <Label
                                                    Text="RECIPIENTES"
                                                    FontSize="10"
                                                    FontAttributes="Bold"
                                                    TextColor="#AAAACC"
                                                    CharacterSpacing="2" />
                                                <Label
                                                    FontSize="52"
                                                    FontAttributes="Bold"
                                                    LineBreakMode="NoWrap">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span
                                                                Text="{Binding Recipientes}"
                                                                FontSize="52"
                                                                FontAttributes="Bold"
                                                                TextColor="#0008FF" />
                                                            <Span
                                                                Text="  rec"
                                                                FontSize="13"
                                                                FontAttributes="Bold"
                                                                TextColor="#AAAACC" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                            </VerticalStackLayout>

                                            <!-- Divisor vertical -->
                                            <BoxView
                                                Grid.Column="1"
                                                WidthRequest="1"
                                                BackgroundColor="#F0F0F8"
                                                VerticalOptions="Fill"
                                                Margin="0,4" />

                                            <VerticalStackLayout Grid.Column="2" Spacing="4" Margin="16,0,0,0">
                                                <Label
                                                    Text="UNIDADES"
                                                    FontSize="10"
                                                    FontAttributes="Bold"
                                                    TextColor="#AAAACC"
                                                    CharacterSpacing="2" />
                                                <Label
                                                    FontSize="52"
                                                    FontAttributes="Bold"
                                                    LineBreakMode="NoWrap">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span
                                                                Text="{Binding UnidadesRestantes}"
                                                                FontSize="52"
                                                                FontAttributes="Bold"
                                                                TextColor="#0A0066" />
                                                            <Span
                                                                Text="  un"
                                                                FontSize="13"
                                                                FontAttributes="Bold"
                                                                TextColor="#AAAACC" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                            </VerticalStackLayout>

                                        </Grid>

                                        <!-- ── Painel expansível ── -->
                                        <VerticalStackLayout IsVisible="False" Spacing="12">

                                            <BoxView HeightRequest="1" BackgroundColor="#F0F0F8" />

                                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">

                                                <Label
                                                    Text="CALCULADO"
                                                    FontSize="10"
                                                    FontAttributes="Bold"
                                                    TextColor="#AAAACC"
                                                    CharacterSpacing="2"
                                                    Grid.Row="0" Grid.Column="0" />
                                                <Label
                                                    FontSize="20"
                                                    FontAttributes="Bold"
                                                    TextColor="#0A0066"
                                                    Grid.Row="1" Grid.Column="0">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{Binding UnidadesExatas, StringFormat='{0:F2}'}" />
                                                            <Span Text=" un" TextColor="#AAAACC" FontSize="13" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>

                                                <Label
                                                    Text="ARREDONDADO"
                                                    FontSize="10"
                                                    FontAttributes="Bold"
                                                    TextColor="#AAAACC"
                                                    CharacterSpacing="2"
                                                    Grid.Row="0" Grid.Column="1" />
                                                <Label
                                                    FontSize="20"
                                                    FontAttributes="Bold"
                                                    TextColor="#0A0066"
                                                    Grid.Row="1" Grid.Column="1">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{Binding UnidadesArredondadas}" />
                                                            <Span Text=" un" TextColor="#AAAACC" FontSize="13" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>

                                            </Grid>

                                            <!-- Aviso de arredondamento -->
                                            <Border
                                                IsVisible="{Binding FoiArredondado}"
                                                BackgroundColor="#F5F5FF"
                                                StrokeShape="RoundRectangle 10"
                                                Stroke="#E0E0FF"
                                                StrokeThickness="1"
                                                Padding="14,10">
                                                <Label FontSize="12" TextColor="#0008FF">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="⚠  " FontAttributes="Bold" />
                                                            <Span Text="{Binding UnidadesExatas, StringFormat='{0:F2}'}" FontAttributes="Bold" />
                                                            <Span Text="  →  " TextColor="#AAAACC" />
                                                            <Span Text="{Binding UnidadesArredondadas}" FontAttributes="Bold" />
                                                            <Span Text=" unidades" TextColor="#0008FF" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                            </Border>

                                        </VerticalStackLayout>
                                        <!-- fim painel expansível -->

                                    </VerticalStackLayout>
                                </Border>

                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <!-- Espaço extra para o FAB não sobrepor o último card -->
                    <BoxView HeightRequest="100" BackgroundColor="Transparent" />

                </VerticalStackLayout>
                <!-- fim PainelResultados -->

            </VerticalStackLayout>
        </ScrollView>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!--  FAB — BOTÃO LIMPAR FLUTUANTE                          -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Grid
            x:Name="BtnLimparContainer"
            IsVisible="False"
            Opacity="0"
            TranslationY="40"
            HorizontalOptions="End"
            VerticalOptions="End"
            Margin="0,0,24,36"
            WidthRequest="68"
            HeightRequest="68">

            <!-- Halo azul sutil -->
            <Ellipse
                WidthRequest="68"
                HeightRequest="68"
                Fill="#200008FF"
                HorizontalOptions="Center"
                VerticalOptions="Center" />

            <!-- Botão redondo -->
            <Border
                x:Name="BtnLimpar"
                WidthRequest="60"
                HeightRequest="60"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                BackgroundColor="#0008FF"
                StrokeThickness="0"
                Stroke="Transparent">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="30" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#0008FF" Offset="0,4" Radius="16" Opacity="0.40" />
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnLimparTapped" />
                </Border.GestureRecognizers>
                <Label
                    Text="↺"
                    FontSize="28"
                    TextColor="#FFFFFF"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Margin="0,0,0,2" />
            </Border>

        </Grid>

    </Grid>
    <!-- fim Grid raiz -->

</ContentPage>
