<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CalculadoraPLS.Views.PlsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:CalculadoraPLS.Models"
    xmlns:vm="clr-namespace:CalculadoraPLS.ViewModels"
    BackgroundColor="#FFFFFF"
    Shell.NavBarIsVisible="False">

    <ContentPage.BindingContext>
        <vm:PlsViewModel />
    </ContentPage.BindingContext>

    <ContentPage.Resources>
        <!-- Remove borda azul padrão do Entry no Android -->
        <Style TargetType="Entry">
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Focused">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="Transparent" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Disabled" />
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </ContentPage.Resources>

    <Grid>

        <!-- ═══════════════════════════════════════════ -->
        <!--  CONTEÚDO PRINCIPAL (scrollável)            -->
        <!-- ═══════════════════════════════════════════ -->
        <ScrollView x:Name="MainScroll">
            <VerticalStackLayout Padding="24,52,24,48" Spacing="0">

                <!-- ══════════════════════════════════════════ -->
                <!--  CABEÇALHO                                 -->
                <!-- ══════════════════════════════════════════ -->
                <VerticalStackLayout Spacing="0" Margin="0,0,0,44">
                    <Label
                        Text="Desenvolvido por Luis Rodrigues"
                        FontSize="11"
                        FontAttributes="Italic"
                        TextColor="#AAAACC"
                        HorizontalOptions="Center"
                        CharacterSpacing="1"
                        Margin="0,0,0,18" />
                    <Label
                        Text="PLS"
                        FontSize="72"
                        FontAttributes="Bold"
                        TextColor="#0A0066"
                        HorizontalOptions="Center"
                        CharacterSpacing="5" />
                    <Label
                        Text="CALCULADORA DE PRODUÇÃO"
                        FontSize="11"
                        FontAttributes="Bold"
                        TextColor="#0008FF"
                        HorizontalOptions="Center"
                        CharacterSpacing="5"
                        Margin="0,6,0,0" />
                    <Grid Margin="0,22,0,0" HeightRequest="2">
                        <BoxView BackgroundColor="#EEEEEE" />
                        <BoxView
                            BackgroundColor="#0008FF"
                            WidthRequest="48"
                            HeightRequest="2"
                            HorizontalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>

                <!-- ══════════════════════════════════════════ -->
                <!--  PAINEL DE VENDAS                          -->
                <!-- ══════════════════════════════════════════ -->
                <VerticalStackLayout Spacing="12" Margin="0,0,0,28">

                    <Label
                        Text="VENDAS"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="#0A0066"
                        CharacterSpacing="5"
                        Margin="2,0,0,4" />

                    <!-- Card: Venda Estimada -->
                    <Border
                        x:Name="CardEstimada"
                        BackgroundColor="#FFFFFF"
                        StrokeShape="RoundRectangle 16"
                        Stroke="#E8E8F0"
                        StrokeThickness="1.5"
                        Padding="20,16">
                        <Border.Shadow>
                            <Shadow Brush="#0008FF" Offset="0,2" Radius="12" Opacity="0.06" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCardEstimadaTapped" />
                        </Border.GestureRecognizers>
                        <Grid RowDefinitions="*,2">
                            <VerticalStackLayout Grid.Row="0" Spacing="6">
                                <Label
                                    Text="VENDA ESTIMADA"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    TextColor="#0A0066"
                                    CharacterSpacing="3" />
                                <Entry
                                    x:Name="EntryEstimada"
                                    Text="{Binding VendaEstimadaFormatada}"
                                    Keyboard="Numeric"
                                    ReturnType="Next"
                                    FontSize="36"
                                    FontAttributes="Bold"
                                    TextColor="#0A0066"
                                    BackgroundColor="Transparent"
                                    PlaceholderColor="#CCCCDD"
                                    Placeholder="R$ 0,00"
                                    Focused="EntryEstimada_Focused"
                                    Unfocused="EntryEstimada_Unfocused"
                                    TextChanged="EntryEstimada_TextChanged"
                                    Completed="EntryEstimada_Completed" />
                            </VerticalStackLayout>
                            <BoxView
                                x:Name="FocusLineEstimada"
                                Grid.Row="1"
                                HeightRequest="2"
                                BackgroundColor="#E8E8F0"
                                VerticalOptions="End" />
                        </Grid>
                    </Border>

                    <!-- Card: Venda Real -->
                    <Border
                        x:Name="CardReal"
                        BackgroundColor="#FFFFFF"
                        StrokeShape="RoundRectangle 16"
                        Stroke="#E8E8F0"
                        StrokeThickness="1.5"
                        Padding="20,16">
                        <Border.Shadow>
                            <Shadow Brush="#0008FF" Offset="0,2" Radius="12" Opacity="0.06" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCardRealTapped" />
                        </Border.GestureRecognizers>
                        <Grid RowDefinitions="*,2">
                            <VerticalStackLayout Grid.Row="0" Spacing="6">
                                <Label
                                    Text="VENDA REAL"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    TextColor="#0A0066"
                                    CharacterSpacing="3" />
                                <Entry
                                    x:Name="EntryReal"
                                    Text="{Binding VendaRealFormatada}"
                                    Keyboard="Numeric"
                                    ReturnType="Next"
                                    FontSize="36"
                                    FontAttributes="Bold"
                                    TextColor="#0A0066"
                                    BackgroundColor="Transparent"
                                    PlaceholderColor="#CCCCDD"
                                    Placeholder="R$ 0,00"
                                    Focused="EntryReal_Focused"
                                    Unfocused="EntryReal_Unfocused"
                                    TextChanged="EntryReal_TextChanged"
                                    Completed="EntryReal_Completed" />
                            </VerticalStackLayout>
                            <BoxView
                                x:Name="FocusLineReal"
                                Grid.Row="1"
                                HeightRequest="2"
                                BackgroundColor="#E8E8F0"
                                VerticalOptions="End" />
                        </Grid>
                    </Border>

                </VerticalStackLayout>

                <!-- ══════════════════════════════════════════ -->
                <!--  PAINEL DE CARNES — INPUTS                 -->
                <!-- ══════════════════════════════════════════ -->
                <VerticalStackLayout Spacing="12" Margin="0,0,0,28">

                    <Label
                        Text="CARNES"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="#0A0066"
                        CharacterSpacing="5"
                        Margin="2,0,0,4" />

                    <!-- ─── Card HB ─────────────────────────────────── -->
                    <Border
                        BackgroundColor="#FFFFFF"
                        StrokeShape="RoundRectangle 16"
                        Stroke="#E8E8F0"
                        StrokeThickness="1.5"
                        Padding="20,18">
                        <Border.Shadow>
                            <Shadow Brush="#0008FF" Offset="0,2" Radius="12" Opacity="0.06" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="14">

                            <!-- Título -->
                            <Label
                                Text="HB"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="#0A0066"
                                CharacterSpacing="2" />

                            <BoxView HeightRequest="1" BackgroundColor="#F0F0F8" />

                            <!-- Recipientes + Unidades -->
                            <Grid ColumnDefinitions="*,24,*">

                                <!-- Recipientes -->
                                <VerticalStackLayout Grid.Column="0" Spacing="6">
                                    <Label
                                        Text="RECIPIENTES"
                                        FontSize="10"
                                        FontAttributes="Bold"
                                        TextColor="#AAAACC"
                                        CharacterSpacing="2" />
                                    <Grid RowDefinitions="*,2">
                                        <Entry
                                            x:Name="EntryHbRecipientes"
                                            Text="{Binding HbRecipientes}"
                                            Keyboard="Numeric"
                                            ReturnType="Next"
                                            FontSize="28"
                                            FontAttributes="Bold"
                                            TextColor="#0008FF"
                                            BackgroundColor="Transparent"
                                            Placeholder="0"
                                            PlaceholderColor="#CCCCDD"
                                            Focused="OnEntryInputFocused"
                                            Unfocused="OnEntryInputUnfocused"
                                            Completed="OnEntryHbRecipientesCompleted" />
                                        <BoxView
                                            Grid.Row="1"
                                            HeightRequest="2"
                                            BackgroundColor="#E8E8F0" />
                                    </Grid>
                                </VerticalStackLayout>

                                <!-- Divisor vertical -->
                                <BoxView
                                    Grid.Column="1"
                                    WidthRequest="1"
                                    BackgroundColor="#F0F0F8"
                                    VerticalOptions="Fill" />

                                <!-- Unidades -->
                                <VerticalStackLayout Grid.Column="2" Spacing="6" Margin="8,0,0,0">
                                    <Label
                                        Text="UNIDADES"
                                        FontSize="10"
                                        FontAttributes="Bold"
                                        TextColor="#AAAACC"
                                        CharacterSpacing="2" />
                                    <Grid RowDefinitions="*,2">
                                        <Entry
                                            x:Name="EntryHbUnidades"
                                            Text="{Binding HbUnidades}"
                                            Keyboard="Numeric"
                                            ReturnType="Next"
                                            FontSize="28"
                                            FontAttributes="Bold"
                                            TextColor="#0A0066"
                                            BackgroundColor="Transparent"
                                            Placeholder="0"
                                            PlaceholderColor="#CCCCDD"
                                            Focused="OnEntryInputFocused"
                                            Unfocused="OnEntryInputUnfocused"
                                            Completed="OnEntryHbUnidadesCompleted" />
                                        <BoxView
                                            Grid.Row="1"
                                            HeightRequest="2"
                                            BackgroundColor="#E8E8F0" />
                                    </Grid>
                                </VerticalStackLayout>

                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- ─── Card Whopper ──────────────────────────────── -->
                    <Border
                        BackgroundColor="#FFFFFF"
                        StrokeShape="RoundRectangle 16"
                        Stroke="#E8E8F0"
                        StrokeThickness="1.5"
                        Padding="20,18">
                        <Border.Shadow>
                            <Shadow Brush="#0008FF" Offset="0,2" Radius="12" Opacity="0.06" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="14">

                            <Label
                                Text="Whopper"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="#0A0066"
                                CharacterSpacing="1" />

                            <BoxView HeightRequest="1" BackgroundColor="#F0F0F8" />

                            <Grid ColumnDefinitions="*,24,*">

                                <VerticalStackLayout Grid.Column="0" Spacing="6">
                                    <Label
                                        Text="RECIPIENTES"
                                        FontSize="10"
                                        FontAttributes="Bold"
                                        TextColor="#AAAACC"
                                        CharacterSpacing="2" />
                                    <Grid RowDefinitions="*,2">
                                        <Entry
                                            x:Name="EntryWhopperRecipientes"
                                            Text="{Binding WhopperRecipientes}"
                                            Keyboard="Numeric"
                                            ReturnType="Next"
                                            FontSize="28"
                                            FontAttributes="Bold"
                                            TextColor="#0008FF"
                                            BackgroundColor="Transparent"
                                            Placeholder="0"
                                            PlaceholderColor="#CCCCDD"
                                            Focused="OnEntryInputFocused"
                                            Unfocused="OnEntryInputUnfocused"
                                            Completed="OnEntryWhopperRecipientesCompleted" />
                                        <BoxView
                                            Grid.Row="1"
                                            HeightRequest="2"
                                            BackgroundColor="#E8E8F0" />
                                    </Grid>
                                </VerticalStackLayout>

                                <BoxView
                                    Grid.Column="1"
                                    WidthRequest="1"
                                    BackgroundColor="#F0F0F8"
                                    VerticalOptions="Fill" />

                                <VerticalStackLayout Grid.Column="2" Spacing="6" Margin="8,0,0,0">
                                    <Label
                                        Text="UNIDADES"
                                        FontSize="10"
                                        FontAttributes="Bold"
                                        TextColor="#AAAACC"
                                        CharacterSpacing="2" />
                                    <Grid RowDefinitions="*,2">
                                        <Entry
                                            x:Name="EntryWhopperUnidades"
                                            Text="{Binding WhopperUnidades}"
                                            Keyboard="Numeric"
                                            ReturnType="Next"
                                            FontSize="28"
                                            FontAttributes="Bold"
                                            TextColor="#0A0066"
                                            BackgroundColor="Transparent"
                                            Placeholder="0"
                                            PlaceholderColor="#CCCCDD"
                                            Focused="OnEntryInputFocused"
                                            Unfocused="OnEntryInputUnfocused"
                                            Completed="OnEntryWhopperUnidadesCompleted" />
                                        <BoxView
                                            Grid.Row="1"
                                            HeightRequest="2"
                                            BackgroundColor="#E8E8F0" />
                                    </Grid>
                                </VerticalStackLayout>

                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- ─── Card Rebel ────────────────────────────────── -->
                    <Border
                        BackgroundColor="#FFFFFF"
                        StrokeShape="RoundRectangle 16"
                        Stroke="#E8E8F0"
                        StrokeThickness="1.5"
                        Padding="20,18">
                        <Border.Shadow>
                            <Shadow Brush="#0008FF" Offset="0,2" Radius="12" Opacity="0.06" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="14">

                            <Label
                                Text="Rebel"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="#0A0066"
                                CharacterSpacing="1" />

                            <BoxView HeightRequest="1" BackgroundColor="#F0F0F8" />

                            <Grid ColumnDefinitions="*,24,*">

                                <VerticalStackLayout Grid.Column="0" Spacing="6">
                                    <Label
                                        Text="RECIPIENTES"
                                        FontSize="10"
                                        FontAttributes="Bold"
                                        TextColor="#AAAACC"
                                        CharacterSpacing="2" />
                                    <Grid RowDefinitions="*,2">
                                        <Entry
                                            x:Name="EntryRebelRecipientes"
                                            Text="{Binding RebelRecipientes}"
                                            Keyboard="Numeric"
                                            ReturnType="Next"
                                            FontSize="28"
                                            FontAttributes="Bold"
                                            TextColor="#0008FF"
                                            BackgroundColor="Transparent"
                                            Placeholder="0"
                                            PlaceholderColor="#CCCCDD"
                                            Focused="OnEntryInputFocused"
                                            Unfocused="OnEntryInputUnfocused"
                                            Completed="OnEntryRebelRecipientesCompleted" />
                                        <BoxView
                                            Grid.Row="1"
                                            HeightRequest="2"
                                            BackgroundColor="#E8E8F0" />
                                    </Grid>
                                </VerticalStackLayout>

                                <BoxView
                                    Grid.Column="1"
                                    WidthRequest="1"
                                    BackgroundColor="#F0F0F8"
                                    VerticalOptions="Fill" />

                                <VerticalStackLayout Grid.Column="2" Spacing="6" Margin="8,0,0,0">
                                    <Label
                                        Text="UNIDADES"
                                        FontSize="10"
                                        FontAttributes="Bold"
                                        TextColor="#AAAACC"
                                        CharacterSpacing="2" />
                                    <Grid RowDefinitions="*,2">
                                        <Entry
                                            x:Name="EntryRebelUnidades"
                                            Text="{Binding RebelUnidades}"
                                            Keyboard="Numeric"
                                            ReturnType="Done"
                                            FontSize="28"
                                            FontAttributes="Bold"
                                            TextColor="#0A0066"
                                            BackgroundColor="Transparent"
                                            Placeholder="0"
                                            PlaceholderColor="#CCCCDD"
                                            Focused="OnEntryInputFocused"
                                            Unfocused="OnEntryInputUnfocused"
                                            Completed="OnEntryRebelUnidadesCompleted" />
                                        <BoxView
                                            Grid.Row="1"
                                            HeightRequest="2"
                                            BackgroundColor="#E8E8F0" />
                                    </Grid>
                                </VerticalStackLayout>

                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
                <!-- fim CARNES -->

                <!-- ══════════════════════════════════════════ -->
                <!--  BOTÃO CALCULAR                            -->
                <!-- ══════════════════════════════════════════ -->
                <Border
                    x:Name="BtnCalcular"
                    BackgroundColor="#0008FF"
                    StrokeShape="RoundRectangle 16"
                    Stroke="Transparent"
                    Margin="0,0,0,40">
                    <Border.Shadow>
                        <Shadow Brush="#0008FF" Offset="0,6" Radius="20" Opacity="0.35" />
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCalcularTapped" />
                    </Border.GestureRecognizers>
                    <Label
                        Text="CALCULAR"
                        FontSize="15"
                        FontAttributes="Bold"
                        TextColor="#FFFFFF"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        CharacterSpacing="5"
                        Padding="0,22" />
                </Border>

                <!-- ══════════════════════════════════════════ -->
                <!--  PAINEL DE RESULTADOS                      -->
                <!-- ══════════════════════════════════════════ -->
                <VerticalStackLayout
                    x:Name="PainelResultados"
                    IsVisible="False"
                    Opacity="0"
                    TranslationY="40"
                    Spacing="14">

                    <BoxView x:Name="ScrollAnchor" HeightRequest="1" BackgroundColor="Transparent" />
                    <BoxView HeightRequest="1" BackgroundColor="#EEEEEE" Margin="0,0,0,4" />

                    <!-- Card da diferença percentual -->
                    <Border
                        x:Name="CardDiferenca"
                        BackgroundColor="#FFFFFF"
                        StrokeShape="RoundRectangle 16"
                        Stroke="#E8E8F0"
                        StrokeThickness="1.5"
                        Padding="24,22"
                        Margin="0,0,0,4"
                        Opacity="0"
                        TranslationY="30">
                        <Border.Shadow>
                            <Shadow Brush="#0008FF" Offset="0,4" Radius="16" Opacity="0.08" />
                        </Border.Shadow>
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label
                                    Text="DIFERENÇA"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    TextColor="#0A0066"
                                    CharacterSpacing="5" />
                                <Label
                                    x:Name="LblDiferenca"
                                    Text="0,00%"
                                    FontSize="45"
                                    FontAttributes="Bold"
                                    TextColor="{Binding CorDiferenca}"
                                    LineBreakMode="NoWrap" />
                            </VerticalStackLayout>
                            <Border
                                BackgroundColor="{Binding CorDiferencaFundo}"
                                StrokeShape="RoundRectangle 10"
                                Stroke="Transparent"
                                Padding="14,8"
                                VerticalOptions="Center"
                                Grid.Column="1">
                                <Label
                                    Text="{Binding LabelTendencia}"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    TextColor="{Binding CorDiferenca}" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Título da seção de carnes -->
                    <Label
                        Text="RESULTADO POR CARNE"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="#0A0066"
                        CharacterSpacing="5"
                        Margin="2,50,0,-30" />

                    <!-- Cards de resultado por carne -->
                    <VerticalStackLayout
                        x:Name="ListaCarnes"
                        BindableLayout.ItemsSource="{Binding Resultados}"
                        Spacing="12">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:ResultadoCarne">
                                <Border
                                    BackgroundColor="#FFFFFF"
                                    StrokeShape="RoundRectangle 16"
                                    Stroke="#E8E8F0"
                                    StrokeThickness="1.5"
                                    Padding="22,20"
                                    Opacity="0"
                                    TranslationY="30">
                                    <Border.Shadow>
                                        <Shadow Brush="#0008FF" Offset="0,4" Radius="16" Opacity="0.07" />
                                    </Border.Shadow>

                                    <VerticalStackLayout Spacing="16">
                                        <VerticalStackLayout.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnCardCarneTapped" />
                                        </VerticalStackLayout.GestureRecognizers>

                                        <!-- Nome da carne + chevron -->
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label
                                                Text="{Binding Nome}"
                                                FontSize="22"
                                                FontAttributes="Bold"
                                                TextColor="#0A0066"
                                                VerticalOptions="Center"
                                                CharacterSpacing="1"
                                                Grid.Column="0" />
                                            <Label
                                                Text="›"
                                                FontSize="32"
                                                FontAttributes="Bold"
                                                TextColor="#CCCCDD"
                                                VerticalOptions="Center"
                                                Grid.Column="1"
                                                Margin="0,0,2,0" />
                                        </Grid>

                                        <BoxView HeightRequest="1" BackgroundColor="#F0F0F8" />

                                        <!-- Recipientes + Unidades avulsas -->
                                        <Grid ColumnDefinitions="*,1,*">

                                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                                <Label
                                                    Text="RECIPIENTES"
                                                    FontSize="10"
                                                    FontAttributes="Bold"
                                                    TextColor="#AAAACC"
                                                    CharacterSpacing="2" />
                                                <Label FontSize="52" FontAttributes="Bold" LineBreakMode="NoWrap">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span
                                                                Text="{Binding RecipientesFinal}"
                                                                FontSize="52"
                                                                FontAttributes="Bold"
                                                                TextColor="#0008FF" />
                                                            <Span
                                                                Text="  rec"
                                                                FontSize="13"
                                                                FontAttributes="Bold"
                                                                TextColor="#AAAACC" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                            </VerticalStackLayout>

                                            <BoxView
                                                Grid.Column="1"
                                                WidthRequest="1"
                                                BackgroundColor="#F0F0F8"
                                                VerticalOptions="Fill"
                                                Margin="0,4" />

                                            <VerticalStackLayout Grid.Column="2" Spacing="4" Margin="16,0,0,0">
                                                <Label
                                                    Text="UNIDADES"
                                                    FontSize="10"
                                                    FontAttributes="Bold"
                                                    TextColor="#AAAACC"
                                                    CharacterSpacing="2" />
                                                <Label FontSize="52" FontAttributes="Bold" LineBreakMode="NoWrap">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span
                                                                Text="{Binding UnidadesRestantesFinal}"
                                                                FontSize="52"
                                                                FontAttributes="Bold"
                                                                TextColor="#0A0066" />
                                                            <Span
                                                                Text="  un"
                                                                FontSize="13"
                                                                FontAttributes="Bold"
                                                                TextColor="#AAAACC" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                            </VerticalStackLayout>

                                        </Grid>

                                        <!-- ── Painel expansível (detalhes) ── -->
                                        <VerticalStackLayout IsVisible="False" Spacing="12">
                                            <BoxView HeightRequest="1" BackgroundColor="#F0F0F8" />

                                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                                                <Label
                                                    Text="CALCULADO"
                                                    FontSize="10"
                                                    FontAttributes="Bold"
                                                    TextColor="#AAAACC"
                                                    CharacterSpacing="2"
                                                    Grid.Row="0" Grid.Column="0" />
                                                <Label
                                                    FontSize="20"
                                                    FontAttributes="Bold"
                                                    TextColor="#0A0066"
                                                    Grid.Row="1" Grid.Column="0">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{Binding UnidadesExatas, StringFormat='{0:F2}'}" />
                                                            <Span Text=" un" TextColor="#AAAACC" FontSize="13" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>

                                                <Label
                                                    Text="ARREDONDADO"
                                                    FontSize="10"
                                                    FontAttributes="Bold"
                                                    TextColor="#AAAACC"
                                                    CharacterSpacing="2"
                                                    Grid.Row="0" Grid.Column="1" />
                                                <Label
                                                    FontSize="20"
                                                    FontAttributes="Bold"
                                                    TextColor="#0A0066"
                                                    Grid.Row="1" Grid.Column="1">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{Binding UnidadesFinais}" />
                                                            <Span Text=" un" TextColor="#AAAACC" FontSize="13" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                            </Grid>

                                            <!-- Aviso de arredondamento -->
                                            <Border
                                                IsVisible="{Binding FoiArredondado}"
                                                BackgroundColor="#F5F5FF"
                                                StrokeShape="RoundRectangle 10"
                                                Stroke="#E0E0FF"
                                                StrokeThickness="1"
                                                Padding="14,10">
                                                <Label FontSize="12" TextColor="#0008FF">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="⚠  " FontAttributes="Bold" />
                                                            <Span Text="{Binding UnidadesExatas, StringFormat='{0:F2}'}" FontAttributes="Bold" />
                                                            <Span Text="  →  " TextColor="#AAAACC" />
                                                            <Span Text="{Binding UnidadesFinais}" FontAttributes="Bold" />
                                                            <Span Text=" unidades" TextColor="#0008FF" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                            </Border>

                                        </VerticalStackLayout>
                                        <!-- fim painel expansível -->

                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="100" BackgroundColor="Transparent" />

                </VerticalStackLayout>
                <!-- fim PainelResultados -->

            </VerticalStackLayout>
        </ScrollView>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!--  FAB — BOTÃO LIMPAR FLUTUANTE                          -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Grid
            x:Name="BtnLimparContainer"
            IsVisible="False"
            Opacity="0"
            TranslationY="40"
            HorizontalOptions="End"
            VerticalOptions="End"
